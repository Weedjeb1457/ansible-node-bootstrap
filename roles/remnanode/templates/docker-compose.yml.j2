services:
  remnanode:
    container_name: remnanode
    hostname: remnanode
    image: remnawave/node:{{ remnanode_image_tag }}
    network_mode: host
    restart: always
    cap_add:
      - NET_ADMIN
{% if remnanode_extra_volumes %}
    volumes:
{% for v in remnanode_extra_volumes %}
      - {{ v }}
{% endfor %}
{% endif %}
    ulimits:
      nofile:
        soft: 1048576
        hard: 1048576
    environment:
      - NODE_PORT={{ remnanode_port }}
      - SECRET_KEY={{ remnanode_secret_key }}
